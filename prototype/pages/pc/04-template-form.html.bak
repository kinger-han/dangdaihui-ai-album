<!-- PAGE_META: {"id": "template-form", "title": "模板编辑"} -->
<div class="page" id="page-template-form" style="display:none">
  <style>
    .form-card { background: #fff; border-radius: 4px; padding: 24px 28px; max-width: 720px; }
    .form-row { display: flex; gap: 16px; margin-bottom: 16px; }
    .form-field { flex: 1; }
    .form-label { font-size: 13px; color: #333; margin-bottom: 6px; display: block; }
    .form-label .req { color: #ff4d4f; margin-left: 2px; }
    .form-input, .form-select, .form-textarea {
      width: 100%; height: 36px; padding: 0 12px;
      border: 1px solid #d9d9d9; border-radius: 4px; font-size: 14px; outline: none;
      box-sizing: border-box;
    }
    .form-input:focus, .form-select:focus, .form-textarea:focus { border-color: #1677ff; box-shadow: 0 0 0 2px rgba(22,119,255,0.1); }
    .form-textarea { height: 72px; padding: 8px 12px; resize: none; }
    .form-tip { font-size: 12px; color: #999; margin-top: 4px; }
    .form-actions { display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid #f0f0f0; }
    .form-preview { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
    .fp-thumb { width: 52px; height: 68px; border-radius: 4px; overflow: hidden; position: relative; background: #F0EAE0; border: 1px dashed #d9d9d9; }
    .fp-thumb .pt-bg3 { position: absolute; inset: 0; }
    .fp-thumb .pt-person3 { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); width: 55%; aspect-ratio: 3/4; border-radius: 3px; z-index: 2; background: linear-gradient(135deg,#F5D0A9,#D9A066); border: 1.5px solid rgba(255,255,255,0.8); }
    .fp-tip { font-size: 12px; color: #999; }
  </style>

  <div class="page-header">
    <div class="page-title" id="tf-title">新增模板 <span class="sub">配置手机端可选模板</span></div>
  </div>

  <div class="form-card">
    <div class="form-preview">
      <span class="fp-thumb" id="tf-thumb"><span class="pt-bg3 wb-1"></span><span class="pt-person3"></span></span>
      <span class="fp-tip">模板缩略图（原型示意，正式版本上传设计稿）</span>
    </div>

    <div class="form-row">
      <div class="form-field">
        <label class="form-label">模板名称<span class="req">*</span></label>
        <input class="form-input" id="tf-name" placeholder="如：盛会留念框">
      </div>
      <div class="form-field">
        <label class="form-label">分类<span class="req">*</span></label>
        <select class="form-select" id="tf-group">
          <option value="classic">庄重经典</option>
          <option value="smart">智能海报</option>
          <option value="aiguofeng">AI 国风</option>
          <option value="aichuangyi">AI 创意</option>
        </select>
      </div>
    </div>

    <div class="form-row">
      <div class="form-field">
        <label class="form-label">能力类型</label>
        <select class="form-select" id="tf-cap">
          <option value="A">A · 经典纪念框</option>
          <option value="B">B · 智能主题海报</option>
          <option value="C">C · AI 艺术创作</option>
        </select>
        <div class="form-tip">仅后台标记使用，前端模板卡片不展示</div>
      </div>
      <div class="form-field">
        <label class="form-label">人数支持</label>
        <select class="form-select" id="tf-people">
          <option value="1 人">1 人</option>
          <option value="1-2 人">1-2 人</option>
          <option value="1-4 人">1-4 人</option>
          <option value="1-6 人">1-6 人</option>
        </select>
      </div>
    </div>

    <div class="form-row">
      <div class="form-field">
        <label class="form-label">预计耗时</label>
        <select class="form-select" id="tf-estTime">
          <option value="约 3 秒">约 3 秒</option>
          <option value="约 10 秒">约 10 秒</option>
          <option value="约 30 秒">约 30 秒</option>
        </select>
      </div>
      <div class="form-field">
        <label class="form-label">状态</label>
        <select class="form-select" id="tf-state">
          <option value="on">启用</option>
          <option value="off">禁用</option>
        </select>
      </div>
    </div>

    <div class="form-row">
      <div class="form-field">
        <label class="form-label">适用建议<span class="req">*</span></label>
        <textarea class="form-textarea" id="tf-guide" placeholder="如：建议多人合照，原图居中，红金边框"></textarea>
        <div class="form-tip">展示在移动端模板卡片上</div>
      </div>
    </div>

    <div class="form-actions">
      <button class="dv-btn" onclick="backToList()">返回</button>
      <button class="dv-btn primary" onclick="saveTemplate()">保存</button>
    </div>
  </div>
</div>

<script>
/* ================= 模板新建/编辑表单页 ================= */
var __EDITING_ID = null;

function init_template_form() {
  __EDITING_ID = window.__editTplId || null;
  var title = document.getElementById('tf-title');
  if (__EDITING_ID) {
    var t = TPL_LIST.filter(function(x){ return x.id === __EDITING_ID; })[0];
    if (t) {
      title.textContent = '编辑模板 <span class="sub">修改后可实时同步手机端</span>';
      document.getElementById('tf-name').value = t.name;
      document.getElementById('tf-group').value = t.group;
      document.getElementById('tf-cap').value = t.cap;
      document.getElementById('tf-people').value = t.people;
      document.getElementById('tf-estTime').value = t.estTime || '约 3 秒';
      document.getElementById('tf-state').value = t.state;
      document.getElementById('tf-guide').value = t.guide || '';
    }
  } else {
    title.textContent = '新增模板 <span class="sub">配置手机端可选模板</span>';
    ['tf-name','tf-group','tf-cap','tf-people','tf-estTime','tf-state','tf-guide'].forEach(function(id){
      var el = document.getElementById(id);
      if (el.tagName === 'SELECT') el.selectedIndex = 0;
      else el.value = '';
    });
    document.getElementById('tf-state').value = 'on';
  }
}
function backToList() {
  protoShowPage('template-mgmt');
  if (typeof init_template_mgmt === 'function') init_template_mgmt();
  document.title = '党代会纪念相册 · 模板管理';
}
function saveTemplate() {
  var name = document.getElementById('tf-name').value.trim();
  var group = document.getElementById('tf-group').value;
  var guide = document.getElementById('tf-guide').value.trim();
  if (!name) { showToast('请填写模板名称', 'warn'); return; }
  if (!guide) { showToast('请填写适用建议', 'warn'); return; }
  var cap = document.getElementById('tf-cap').value;
  var people = document.getElementById('tf-people').value;
  var estTime = document.getElementById('tf-estTime').value;
  var state = document.getElementById('tf-state').value;
  var groupName = { classic: '庄重经典', smart: '智能海报', aiguofeng: 'AI 国风', aichuangyi: 'AI 创意' }[group];
  if (__EDITING_ID) {
    var t = TPL_LIST.filter(function(x){ return x.id === __EDITING_ID; })[0];
    if (t) {
      t.name = name; t.group = group; t.groupName = groupName; t.cap = cap;
      t.people = people; t.guide = guide; t.estTime = estTime; t.state = state;
      showToast('模板已保存：' + name, 'success');
    }
  } else {
    var newId = 'tpl' + (TPL_LIST.length + 1);
    TPL_LIST.push({ id: newId, name: name, group: group, groupName: groupName, cap: cap,
      people: people, guide: guide, estTime: estTime, state: state, uses: 0, time: '09-02 现在' });
    showToast('模板已新增：' + name, 'success');
  }
  backToList();
}
</script>