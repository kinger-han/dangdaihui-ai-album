<!-- PAGE_META: {"id": "photo-detail", "title": "照片详情"} -->
<div class="page" id="page-photo-detail" style="display:none">
  <style>
    .pd-card { background: #fff; border-radius: 8px; padding: 24px; max-width: 860px; }
    .pd-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
    .pd-title { font-size: 16px; font-weight: 600; color: #333; }
    .pd-sub { font-size: 12px; color: #999; margin-left: 8px; font-weight: 400; }
    .pd-body { display: flex; gap: 24px; }
    .pd-photo { width: 240px; flex-shrink: 0; }
    .pd-img {
      width: 100%; aspect-ratio: 3/4; border-radius: 6px; overflow: hidden;
      position: relative; background: #26262A;
    }
    .pd-img .photo-bg { position: absolute; inset: 0; }
    .pd-img .photo-person {
      position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%);
      width: 60%; aspect-ratio: 3/4; border-radius: 8px; z-index: 2;
      box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    }
    .pd-note { font-size: 12px; color: #999; margin-top: 10px; text-align: center; }
    .pd-fields { flex: 1; }
    .pd-field-row { display: flex; padding: 10px 0; border-bottom: 1px solid #f0f0f0; font-size: 13px; }
    .pd-field-row:last-child { border-bottom: none; }
    .pd-label { width: 120px; color: #999; flex-shrink: 0; }
    .pd-value { color: #333; flex: 1; word-break: break-all; }
    .pd-value .badge-status { display: inline-block; padding: 2px 10px; border-radius: 3px; font-size: 12px; }
    .pd-value .badge-status.active { background: #f6ffed; color: #52c41a; }
    .pd-value .badge-status.disabled { background: #f5f5f5; color: #999; }
    .pd-actions { display: flex; justify-content: flex-end; gap: 12px; margin-top: 20px; padding-top: 16px; border-top: 1px solid #f0f0f0; }
  </style>

  <div class="page-header">
    <div class="page-title">照片详情 <span class="sub" id="pd-no"></span></div>
  </div>

  <div class="pd-card">
    <div class="pd-head">
      <span class="pd-title">纪念照信息<span class="pd-sub">照片管理 / 上屏展示审核 共用</span></span>
    </div>
    <div class="pd-body">
      <div class="pd-photo">
        <div class="pd-img" id="pd-img"><div class="photo-bg wb-1"></div><div class="photo-person"></div></div>
        <div class="pd-note">原型示意：正式版本展示真实生成图片</div>
      </div>
      <div class="pd-fields" id="pd-fields"></div>
    </div>
    <div class="pd-actions">
      <button class="dv-btn" onclick="goBackFromDetail()">返回</button>
    </div>
  </div>
</div>

<script>
/* ================= 照片详情页（照片管理 / 上屏展示审核 共用） ================= */
var DETAIL_NO = null;

function init_photo_detail(payload) {
  if (payload && payload.no) DETAIL_NO = payload.no;
  var t = null;
  if (DETAIL_NO) t = window.__PHOTO_DETAILS ? __PHOTO_DETAILS[DETAIL_NO] : null;
  if (!t) {
    document.getElementById('pd-no').textContent = '';
    document.getElementById('pd-fields').innerHTML = '<div style="color:#999;padding:30px 0;text-align:center">未找到该照片</div>';
    return;
  }
  document.getElementById('pd-no').textContent = t.no;
  var img = document.getElementById('pd-img');
  img.innerHTML = '<div class="photo-bg wb-' + (t.bg || 1) + '"></div><div class="photo-person"></div>';

  var rows = [
    ['编号', t.no],
    ['模板', t.tpl],
    ['能力类型', t.capName || '—'],
    ['选用分类', t.groupName || '—'],
    ['微信号', t.wx],
    ['来源屏幕', t.screen || '—'],
    ['生成状态', t.gen ? '<span class="badge-status ' + (t.gen === '成功' ? 'active' : 'disabled') + '">' + t.gen + '</span>' : '—'],
    ['AI 初审', t.ai ? t.ai : '—'],
    ['展示状态', t.on ? '<span class="badge-status active">展示中</span>' : '<span class="badge-status disabled">未展示</span>'],
    ['展示时间', t.onTime || t.time || '—'],
    ['创建时间', t.time || '—'],
    ['使用次数', t.uses != null ? t.uses : '—']
  ];
  var html = '';
  rows.forEach(function(r) {
    html += '<div class="pd-field-row"><div class="pd-label">' + r[0] + '</div><div class="pd-value">' + r[1] + '</div></div>';
  });
  document.getElementById('pd-fields').innerHTML = html;
}
function goBackFromDetail() {
  var backTo = window.__DETAIL_BACK || 'photo-mgmt';
  protoShowPage(backTo);
  if (backTo === 'photo-mgmt' && typeof init_photo_mgmt === 'function') init_photo_mgmt();
  if (backTo === 'selection-mgmt' && typeof init_selection_mgmt === 'function') init_selection_mgmt();
}
</script>